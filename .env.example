# ============================================================
# YYC³ AI 生态系统 - 环境变量示例
# 复制为 .env.local 后填入实际值, 切勿提交 .env.local 到 Git
# ============================================================

# ===== 应用元信息 =====
VITE_APP_NAME="YYC³ Cloud Intelli-Matrix"
VITE_APP_VERSION="1.1.0"
VITE_APP_ENV=development   # development | staging | production

# ===== 默认 LLM Provider (可选; 用户在前端配置会覆盖) =====
# 服务端默认 Provider (若设置, 前端不再要求用户输入 Key)
VITE_DEFAULT_LLM_PROVIDER=manual   # openai | anthropic | qwen | deepseek | kimi | manual
VITE_DEFAULT_LLM_STRATEGY=cost     # cost | latency | quality | manual

# 服务端代理模式 — 通过同源 API 代理 LLM 请求 (避免 CORS + 隐藏 Key)
# 推荐生产环境使用, 见 api/chat/route.ts
LLM_PROXY_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# ===== 安全 (服务端) =====
# CORS 允许的源 (逗号分隔)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# 速率限制 (每分钟请求数, 按 IP)
RATE_LIMIT_PER_MINUTE=60
# AES-256-GCM 主密钥 (32 字节 base64) — 用于服务端加密 (区别于浏览器 Keyring)
SERVER_MASTER_KEY=

# ===== Vercel / 部署 =====
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ===== 监控 (可选) =====
SENTRY_DSN=
POSTHOG_KEY=

# ===== CI/CD (GitHub Actions, secrets 中) =====
# GH_PAT=
# VERCEL_TOKEN=
# SNYK_TOKEN=
