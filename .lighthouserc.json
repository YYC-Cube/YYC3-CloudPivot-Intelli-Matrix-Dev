{
  "$schema": "https://raw.githubusercontent.com/GoogleChrome/lighthouse/main/types/lhci.json",
  "ci": {
    "collect": {
      "staticDistDir": "./apps/full/dist",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        }
      },
      "url": [
        "http://localhost/index.html",
        "http://localhost/index.html#/welcome"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.85 }],
        "categories:pwa": ["warn", { "minScore": 0.6 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1500 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "interactive": ["warn", { "maxNumericValue": 3500 }],
        "unused-javascript": ["warn", { "maxNumericValue": 50000 }],
        "render-blocking-resources": ["warn", { "maxNumericValue": 0 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "server": {}
  }
}
