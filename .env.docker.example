# Docker Compose 环境变量示例
# 复制为 .env.docker 后填入实际值
VITE_APP_NAME="YYC³ Cloud Intelli-Matrix"
VITE_APP_ENV=production

# LLM Provider Key (服务端代理模式, 见 api/chat/stream.ts)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=

# CORS 允许的源 (逗号分隔)
CORS_ALLOWED_ORIGINS=https://yyc3.example.com
