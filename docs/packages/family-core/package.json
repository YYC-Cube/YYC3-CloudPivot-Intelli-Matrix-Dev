{
  "name": "@yyc3/family-core",
  "version": "0.1.0",
  "description": "YYC³ AI Family 核心引擎 — 编排、模型路由、消息总线",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
